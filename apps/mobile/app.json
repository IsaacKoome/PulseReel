{
  "expo": {
    "name": "MimiReel",
    "slug": "pulsereel",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mimireel",
    "icon": "./assets/pulsereel-icon-v1.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050505",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mimireel.app"
    },
    "android": {
      "package": "com.mimireel.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/pulsereel-adaptive-foreground-v1.png",
        "monochromeImage": "./assets/pulsereel-monochrome-v1.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-image",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "MimiReel uses your camera to record the clip you choose for your movie.",
          "microphonePermission": "MimiReel uses your microphone to include your voice in the clip you record.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MimiReel lets you choose a photo or video you want to turn into a movie."
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4987d251-7cbb-4840-a668-f0800bbed6e7"
      }
    },
    "owner": "komecon"
  }
}
